{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "NZQEV",
      "x": 0,
      "y": -420,
      "name": "748 — Frontman chat and its missions: overview",
      "theme": {
        "mode": "dark"
      },
      "width": 4400,
      "fill": "$bg",
      "cornerRadius": 10,
      "stroke": "$border",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 14,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "y49khQ",
          "name": "Title",
          "fill": "$text-hi",
          "content": "#748 — Track the missions a frontman chat starts, in its right side panel",
          "fontFamily": "$font-ui",
          "fontSize": 22,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "GJ1oE",
          "name": "Direction",
          "fill": "$text-mid",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The chat stays outside its missions. Runner links each mission to the chat that started it and shows them in the chat's side panel. Updates reach you through the panel and notifications; the chat hears about a mission only when you ask it, or press Catch up chat, which types one line.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "vvOCP",
          "name": "Options",
          "width": "fill_container",
          "gap": 80,
          "children": [
            {
              "type": "frame",
              "id": "d14BJo",
              "name": "Option A · Missions tab with cards",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "g7Rkd",
                  "name": "Option title",
                  "fill": "$accent",
                  "content": "A · Missions tab with cards",
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Pk7h4",
                  "name": "Option text",
                  "fill": "$text-mid",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A Role | Missions tab pair; one card per mission with its state, latest handoff or question and inline answers. Strongest at a glance, most room per mission.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "HWzl0",
              "name": "Option B · Missions above the role",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "kdzqF",
                  "name": "Option title",
                  "fill": "$accent",
                  "content": "B · Missions above the role",
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "B7E0XL",
                  "name": "Option text",
                  "fill": "$text-mid",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No tabs: a compact list leads the panel, the row that needs you expands inline, and the role and prompt collapse below. Densest; the panel always opens on missions.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "yIwha",
              "name": "Option C · Activity since you last looked",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "s1KmYz",
                  "name": "Option title",
                  "fill": "$accent",
                  "content": "C · Activity since you last looked",
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "lvETX",
                  "name": "Option text",
                  "fill": "$text-mid",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One feed of the important events across all of this chat's missions, newest first, with a single Catch up chat for everything new. Best for several busy missions.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "rDVPl",
          "name": "Open questions",
          "fill": "$warn",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Open: panel shows only this chat's missions, or the project's too? Keep Catch up chat, or always ask the frontman yourself? Does a mission link back to its chat (right)?",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    },
